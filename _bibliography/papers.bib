@article{dubanaeva2025makeup,
  abbr={CV},
  bibtex_show={true},
  title={Aesthetics-Aware Generative Makeup Transfer},
  author={Dubanaeva, Dinaiym},
  abstract={We present an aesthetics-aware neural makeup transfer system that overcomes the "blind style transfer" limitation of methods such as BeautyGAN. Our pipeline combines a rule-based expert system — encoding professional makeup artistry knowledge (face-shape analysis, skin undertone classification) — with a conditional GAN based on a Mask-Conditioned U-Net with Adaptive Instance Normalisation (AdaIN). A key contribution is the programmatic generation of paired training data via Poisson Image Editing, eliminating the need for scarce annotated makeup pairs. Our best model achieves SSIM = 0.906, LPIPS = 0.034 at 0.88 ms inference on a single RTX 4080 SUPER GPU — outperforming BeautyGAN on all metrics while being 14× faster.},
  journal={Under Review},
  year={2025},
  html={https://www.overleaf.com/read/jfdcgnhphzfd#1b0730},
  selected={true},
  note={Under Review}
}

@article{dubanaeva2025kyrgyz_tts,
  abbr={NLP},
  bibtex_show={true},
  title={Morphology-Aware Text Normalization and Kyrgyz G2P for Low-Resource Speaker-Adaptive Text-to-Speech},
  author={Dubanaeva, Dinaiym},
  abstract={Kyrgyz TTS remains challenging due to agglutinative morphology, stress shifts triggered by clitics/suffixes, and scarce high-quality paired data. This paper presents a morphology-aware preprocessing pipeline and an open-source Kyrgyz grapheme-to-phoneme (G2P) library designed for high-fidelity speaker-adaptive TTS. The pipeline performs text normalization, rule-based stress assignment with explicit handling of interrogative particles and predicative/person suffixes, syllabification-driven stress positioning, and Kyrgyz phonological post-processing rules for context-dependent consonants and vowel length.},
  journal={Under Review},
  year={2025},
  html={https://www.overleaf.com/read/gbgrfqfyzqnx#417246},
  selected={true},
  note={Under Review}
}

@article{dubanaeva2025wordproblem,
  abbr={FM},
  bibtex_show={true},
  title={A Hybrid Framework for the Word Problem in Group Theory: Combining Symbolic Computation and Formal Verification},
  author={Dubanaeva, Dinaiym},
  abstract={The Word Problem for finitely generated groups is a cornerstone of Combinatorial Group Theory, known for its status as an undecidable problem in the general case. This paper introduces the Word Problem for Groups (WPG) Solver, a novel hybrid computational platform that leverages Symbolic Computation (SymPy) for efficient parsing and simplification and integrates Formal Verification (Lean 4) to ensure the logical correctness of the underlying group algorithms. We demonstrate a structured approach to classify input group presentations and dispatch the query to the most suitable, formally verified solver.},
  journal={Under Review},
  year={2025},
  html={https://www.overleaf.com/read/ckxrrhjwzfck#0374f8},
  note={Under Review}
}

@article{dubanaeva2025trade,
  abbr={DS},
  bibtex_show={true},
  title={Structural Duality in Emerging Markets: HS-to-Sector Mapping and Partner-Role Diagnostics for the Kyrgyz Republic's Trade (2019--2024)},
  author={Dubanaeva, Dinaiym and Shambetova, Burul},
  abstract={We propose a reproducible data-science workflow to diagnose partner--sector dependencies in the Kyrgyz Republic's goods trade (2019--2024). HS-based flows are mapped into macro-sectors and transformed into partner indicators (turnover, net trade, import coverage, and role labels). Visual diagnostics and tables reveal a structural duality: a China-centered import-deficit pole in manufactured goods and a narrow gold-driven export-surplus pole concentrated in the United Kingdom and Switzerland.},
  journal={SciProfiles},
  year={2025},
  html={https://sciprofiles.com/publication/view/83046e2a6589e4ffcade1f782c728578},
  selected={true}
}

@article{dubanaeva2025ambulance,
  abbr={Health},
  bibtex_show={true},
  title={Trends Detection, Statistical Analysis, Location-Based Clustering of Ambulance Calls in Bishkek (2018--2024)},
  author={Dubanaeva, Dinaiym},
  abstract={In the field of healthcare, the study of ambulance calls for the period from 2018 to 2024 in Bishkek identifies correlations highlighting various aspects of ambulance activity, including patient demographics (age and gender), time trends, causes of calls, and geographical and temporal distribution of waiting for help. Using K-Means clustering and statistical analysis, the study identifies the most common medical problems among women, the most vulnerable age groups, and the relationship between types of challenges and health conditions, recommending optimized station placements.},
  journal={AAS Ala-Too},
  year={2025},
  month={May},
  html={https://www.elibrary.ru/item.asp?id=82276214}
}
